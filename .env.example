# Supabase dashboard > Connect: use the project URL and publishable key.
# These values are public in the app bundle. Never use a secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Node API. For Expo Go on a phone, use your computer's Wi-Fi IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
